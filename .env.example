# Backend-only names/examples. The Vercel frontend needs NO environment variables.
# This file is NOT automatically loaded.
# Set process variables or use a private runtime --env-file outside the checkout.
LLM_BASE_URL=https://gen.pollinations.ai/v1
# Pollinations catalog ID used for the live public-case and paraphrase checks.
LLM_MODEL=google/gemini-3.8-flash
# Supply a fresh restricted key privately at runtime; never use a chat-exposed key for deployment.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=10
REQUEST_DEADLINE_SECONDS=25
MAX_CONCURRENT_REQUESTS=2
MAX_PENDING_REQUESTS=6
# Comma-separated exact HTTPS frontend origins, without trailing slashes. Empty disables CORS.
# Local development origins such as http://localhost:3000 are also accepted.
CORS_ORIGINS=
PORT=8080